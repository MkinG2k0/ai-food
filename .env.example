# AI Food — скопируй в .env и заполни. Секреты не коммитить.

# ─── AI Gateway ───────────────────────────────────────────
VITE_AI_GATEWAY_URL=
VITE_AI_GATEWAY_API_KEY=

# Опционально: legacy API base (axios client)
# VITE_API_URL=http://localhost:3001

# ─── Telegram Auth (клиент) ───────────────────────────────
# Username бота без @: из @BotFather (например my_food_bot)
VITE_TELEGRAM_BOT_USERNAME=

# Публичный URL приложения (Login Widget domain в BotFather)
# Сейчас: ai-food-mobile.vercel.app
VITE_APP_URL=https://ai-food-mobile.vercel.app

# true = кнопка «Войти (демо)» на /login; false = только реальный виджет (когда будет)
VITE_AUTH_MOCK=true

# Server-side (ai-app .env only — never VITE_*):
# DATABASE_URL=  AUTH_SECRET=  TELEGRAM_BOT_TOKEN=  FREE_GENERATION_LIMIT=50
# SUBSCRIPTION_PRICE_KOPECKS=199000  SUBSCRIPTION_DURATION_DAYS=365
# TBANK_TERMINAL_KEY=  TBANK_PASSWORD=  TBANK_API_URL=  TBANK_MOCK=true
# PUBLIC_APP_URL=http://localhost:5173
