{
  "name": "ai-food-base",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:food": "turbo run dev --filter=ai-food",
    "dev:app": "turbo run dev --filter=openrouter-gateway",
    "dev:web": "turbo run dev --filter=ai-web",
    "build": "turbo run build",
    "build:food": "turbo run build --filter=ai-food",
    "build:app": "turbo run build --filter=openrouter-gateway",
    "build:web": "turbo run build --filter=ai-web",
    "start": "turbo run start",
    "start:app": "turbo run start --filter=openrouter-gateway",
    "start:prod:app": "pnpm --filter openrouter-gateway run start:prod",
    "test": "turbo run test test:e2e",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter ai-food test:e2e",
    "test:e2e:ui": "pnpm --filter ai-food test:e2e:ui",
    "type-check": "turbo run type-check",
    "lint": "turbo run type-check"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@9.6.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "9.6.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  }
}
