generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionStatus {
  none
  active
  canceled
  past_due
}

enum PaymentStatus {
  pending
  confirmed
  rejected
  refunded
}

model User {
  id                     String             @id @default(cuid())
  telegramId             String             @unique
  username               String?
  firstName              String?
  lastName               String?
  photoUrl               String?
  dataConsentAt          DateTime?
  dataConsentVersion     String?
  nutritionProfile       Json?
  subscriptionStatus     SubscriptionStatus @default(none)
  subscriptionExpiresAt  DateTime?
  /** Latest weight goal (kg); synced via POST /user/weights/sync */
  goalKg                 Float?
  /** App settings blob; synced via POST /user/settings/sync (LWW) */
  clientSettings           Json?
  settingsClientUpdatedAt  DateTime?
  /** Streak gamification blob; synced via POST /user/streak/sync (LWW) */
  clientStreak               Json?
  streakClientUpdatedAt      DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  devices                Device[]
  usageEvents            UsageEvent[]
  payments               Payment[]
  meals                  Meal[]
  weightEntries          WeightEntry[]
  favorites              Favorite[]
}

model Meal {
  id                   String    @id
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  timestamp            DateTime
  name                 String?
  items                Json
  totalCalories        Float
  portions             Float?
  totalGrams           Float?
  status               String?
  healthiness          Float?
  confidence           Float?
  analyzeErrorCode     String?
  micronutrients       Json?
  aiModel              String?
  portionReference     String?
  addedSugar           Float?
  confidenceReason     String?
  healthinessReason    String?
  disclaimers          Json?
  customContent        String?
  customContentEntries Json?
  imageUri             String?
  imageUris            Json?
  clientUpdatedAt      DateTime
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId, timestamp])
  @@index([userId, clientUpdatedAt])
}

model WeightEntry {
  id              String    @id
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Local calendar day YYYY-MM-DD */
  date            String
  kg              Float
  clientUpdatedAt DateTime
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, date])
  @@index([userId, clientUpdatedAt])
}

model Favorite {
  id               String    @id
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceMealId     String
  name             String
  items            Json
  totalCalories    Float
  portions         Float?
  imageUri         String?
  imageUris        Json?
  healthiness      Float?
  confidence       Float?
  micronutrients   Json?
  /** Client FavoriteFood.createdAt */
  createdAtClient  DateTime?
  clientUpdatedAt  DateTime
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, clientUpdatedAt])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  amount         Int
  status         PaymentStatus @default(pending)
  promoCode      String?
  tbankPaymentId String?       @unique
  tbankOrderId   String        @unique
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, status])
  @@index([promoCode, status])
}

model Device {
  id          String       @id @default(cuid())
  deviceId    String       @unique
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  usageEvents UsageEvent[]
}

model UsageEvent {
  id        String   @id @default(cuid())
  kind      String
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([deviceId, kind])
  @@index([userId, kind])
}

model AppSettings {
  id                       Int      @id @default(1)
  subscriptionPriceKopecks Int?
  subscriptionDurationDays Int?
  freeGenerationLimit      Int?
  authLoginGenerationBonus Int?
  updatedAt                DateTime @updatedAt
}

model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GatewayRequest {
  id         String   @id @default(cuid())
  type       String
  stream     Boolean  @default(false)
  ok         Boolean
  ttfbMs     Int?
  durationMs Int?
  userId     String?
  deviceId   String?
  createdAt  DateTime @default(now())

  @@index([createdAt, type])
  @@index([type, createdAt])
}
