# Gateway (apps/ai-app) — server secrets only. Client VITE_* → apps/ai-food/.env

OPENROUTER_API_KEY=your_key_here
# Optional attribution headers for openrouter.ai (shown in their dashboard/rankings).
# OPENROUTER_HTTP_REFERER=https://your-app.example.com
# OPENROUTER_APP_TITLE=Your App Name
# Optional shared secret for caller apps (match VITE_AI_GATEWAY_API_KEY). Omit to disable gateway auth.
# API_KEY=your_gateway_secret
# PORT=3000
# true → bind 127.0.0.1; anything else → 0.0.0.0
# IS_LOCAL=true


# ─── Auth + free quota (Postgres / Prisma) ────────────────
# Paste your Postgres URL when ready, then: npx prisma migrate dev --name init
# (URL is read via prisma.config.ts — not from schema.prisma)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# JWT signing secret (min 32 chars) — generate: openssl rand -base64 32
# AUTH_SECRET=

# Flash-Call provider key (server only — never expose to Vite)
# FLASHCALL_API_KEY=

# Guest analyze+refine free budget
FREE_GENERATION_LIMIT=50
# Extra generations after sign-in (summed with FREE_GENERATION_LIMIT → 150)
AUTH_LOGIN_GENERATION_BONUS=100

# Quota: unset = enforce when DATABASE_URL set; true = always; false = never
# QUOTA_ENFORCE=

# ─── Yearly license (one-time T-Bank) ─────────────────────
# Price in kopecks (100.00 RUB = 10000)
SUBSCRIPTION_PRICE_KOPECKS=10000
SUBSCRIPTION_DURATION_DAYS=365

# Public origin of ai-food (Success/Fail/Notification base URLs)
# PUBLIC_APP_URL=http://localhost:5173

# T-Bank Acquiring (server only — never VITE_*)
# TBANK_TERMINAL_KEY=
# TBANK_PASSWORD=
# TBANK_API_URL=https://securepay.tinkoff.ru
# TLS: securepay uses Russian Trusted Root CA — bundled in certs/russian-trusted-ca-bundle.pem
# (loaded automatically by src/lib/tbank.ts; no NODE_EXTRA_CA_CERTS needed)
# Local/dev without terminal keys:
# TBANK_MOCK=true
