# Gateway (apps/ai-app) — server secrets only. Client VITE_* → apps/ai-food/.env
# Dokploy: задай эти же ключи во вкладке Env приложения Gateway (см. docs/DOKPLOY.md)

OPENROUTER_API_KEY=your_key_here
# Management key (Account → Management Keys) — admin balance/activity only; not for completions
# OPENROUTER_MANAGEMENT_API_KEY=
# Model for /v1/food/* routes (analyze/refine/ask). Fallback: google/gemini-3-flash-preview
# OPENROUTER_MODEL=google/gemini-3-flash-preview
# Optional attribution headers for openrouter.ai (shown in their dashboard/rankings).
# OPENROUTER_HTTP_REFERER=https://your-app.example.com
# OPENROUTER_APP_TITLE=Your App Name
# Optional shared secret for caller apps (match VITE_AI_GATEWAY_API_KEY). Omit to disable gateway auth.
# API_KEY=your_gateway_secret
# PORT=3000
# true → bind 127.0.0.1; anything else → 0.0.0.0
# IS_LOCAL=true
# В Dokploy / Docker: IS_LOCAL=false (слушать 0.0.0.0)


# ─── Auth + free quota (Postgres / Prisma) ────────────────
# Paste your Postgres URL when ready, then: npx prisma migrate dev --name init
# (URL is read via prisma.config.ts — not from schema.prisma)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# JWT signing secret (min 32 chars) — generate: openssl rand -base64 32
# AUTH_SECRET=

# Demo login POST /auth/demo/login — unset/true = enabled; false = 403
# AUTH_MOCK=true

# Telegram bot auth (server only — never expose to Vite)
# TELEGRAM_BOT_TOKEN=
# alias also accepted: AUTH_TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# Public origin of this gateway (webhook URL base; not the frontend)
# PUBLIC_GATEWAY_URL=http://127.0.0.1:3000

# Guest analyze+refine free budget and login bonus are configured in admin UI
# (AppSettings /admin/pricing), defaults: free=50, login bonus=100

# Quota: unset = enforce when DATABASE_URL set; true = always; false = never
# QUOTA_ENFORCE=

# ─── Yearly license (one-time T-Bank) ─────────────────────
# Price in kopecks (100.00 RUB = 10000)
SUBSCRIPTION_PRICE_KOPECKS=10000
SUBSCRIPTION_DURATION_DAYS=365

# Public origin of ai-food web/PWA (Success/Fail redirect for browser clients)
# PUBLIC_APP_URL=http://localhost:5173
# Native Android/iOS return after T-Bank uses aifood:// deep link (client: native)
# NATIVE_APP_SCHEME=aifood

# T-Bank Acquiring (server only — never VITE_*)
# TBANK_TERMINAL_KEY=
# TBANK_PASSWORD=
# TBANK_API_URL=https://securepay.tinkoff.ru
# TLS: securepay uses Russian Trusted Root CA — bundled in certs/russian-trusted-ca-bundle.pem
# (loaded automatically by src/lib/tbank.ts; no NODE_EXTRA_CA_CERTS needed)
# Local/dev without terminal keys:
# TBANK_MOCK=true

# Admin API (ai-web server → gateway). Required for /admin/* (fail-closed if unset).
# ADMIN_API_KEY=
