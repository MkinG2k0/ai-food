# https://openrouter.ai/docs/quickstart — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Fallback OpenRouter model when the client omits body.model
# See https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional attribution headers for OpenRouter rankings
# OPENROUTER_HTTP_REFERER=https://github.com/ai-food
# OPENROUTER_APP_TITLE=AI Food

PORT=3001
