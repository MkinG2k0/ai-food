<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="aifood"
                    android:host="add" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="aifood"
                    android:host="stats" />
            </intent-filter>

        </activity>

        <receiver
            android:name=".AddFoodWidgetProvider"
            android:exported="true"
            android:label="@string/widget_add_food_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/add_food_widget_info" />
        </receiver>

        <receiver
            android:name=".ScanWidgetProvider"
            android:exported="true"
            android:label="@string/widget_action_scan_short">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_scan_info" />
        </receiver>

        <receiver
            android:name=".ScanDescribeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_action_scan_describe_short">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_scan_describe_info" />
        </receiver>

        <receiver
            android:name=".GalleryWidgetProvider"
            android:exported="true"
            android:label="@string/widget_action_gallery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_gallery_info" />
        </receiver>

        <receiver
            android:name=".DescribeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_action_describe">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_describe_info" />
        </receiver>

        <receiver
            android:name=".ManualWidgetProvider"
            android:exported="true"
            android:label="@string/widget_action_manual">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_manual_info" />
        </receiver>

        <receiver
            android:name=".FavoritesWidgetProvider"
            android:exported="true"
            android:label="@string/widget_action_favorites">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_favorites_info" />
        </receiver>

        <receiver
            android:name=".KbjuRingsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_kbju_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_kbju_rings_info" />
        </receiver>

        <receiver
            android:name=".KbjuActivityRingsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_kbju_activity_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_kbju_activity_rings_info" />
        </receiver>

        <receiver
            android:name=".WeeklyCaloriesWidgetProvider"
            android:exported="true"
            android:label="@string/widget_week_kcal_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weekly_calories_info" />
        </receiver>

        <!-- Refresh all widgets when system night mode toggles (API 29+). -->
        <receiver
            android:name=".WidgetThemeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.ENTERING_NIGHT_MODE" />
                <action android:name="android.app.action.EXITING_NIGHT_MODE" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
