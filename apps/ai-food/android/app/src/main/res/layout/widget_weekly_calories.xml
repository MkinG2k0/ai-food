<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_week_kcal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_button_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_week_kcal_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_week_kcal_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_week_kcal_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="2dp"
        android:textColor="@color/widget_label"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp"
            android:text="@string/widget_week_kcal_legend_protein"
            android:textColor="@color/widget_kbju_protein"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp"
            android:text="@string/widget_week_kcal_legend_fat"
            android:textColor="@color/widget_kbju_fat"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_week_kcal_legend_carbs"
            android:textColor="@color/widget_kbju_carbs"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_week_kcal_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_week_kcal_description"
        android:scaleType="fitXY" />
</LinearLayout>
