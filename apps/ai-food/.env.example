# AI Food (apps/ai-food) — скопируй в .env и заполни. Секреты не коммитить.
# Только VITE_* — серверные секреты живут в apps/ai-app/.env
# Dokploy: VITE_* задаются на build фронта (см. docs/DOKPLOY.md)

# ─── AI Gateway ───────────────────────────────────────────
# Локально: http://127.0.0.1:3000  (pnpm dev:app)
# Dokploy: https://<gateway-domain>
VITE_AI_GATEWAY_URL=
VITE_AI_GATEWAY_API_KEY=

# Опционально: legacy API base (axios client)
# VITE_API_URL=http://localhost:3001

# ─── Telegram Auth (bot deep-link) ────────────────────────
# Логин: POST /auth/telegram/start → открыть botDeepLink → poll /auth/telegram/status.
# Login Widget и domain в BotFather не нужны.
# Опционально: username бота без @ — только для подписи на кнопке «Войти через Telegram»
# VITE_TELEGRAM_BOT_USERNAME=

# Публичный URL фронта (редиректы после оплаты и т.п.)
VITE_APP_URL=https://ai-food-mobile.vercel.app

# true = кнопка «Войти (демо)» → POST gateway /auth/demo/login (нужны VITE_AI_GATEWAY_URL + AUTH_MOCK на gateway)
# false = только Telegram bot login
VITE_AUTH_MOCK=true

# Публичный сайт с legal-страницами (без trailing slash), напр. https://ai-food.example
# VITE_LEGAL_SITE_URL=

# Server-side → apps/ai-app/.env only (never VITE_*):
# DATABASE_URL=  AUTH_SECRET=  TELEGRAM_BOT_TOKEN=  TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=  PUBLIC_GATEWAY_URL=http://127.0.0.1:3000
# FREE_GENERATION_LIMIT=50  SUBSCRIPTION_PRICE_KOPECKS=10000  SUBSCRIPTION_DURATION_DAYS=365
# TBANK_TERMINAL_KEY=  TBANK_PASSWORD=  TBANK_API_URL=  TBANK_MOCK=true
# PUBLIC_APP_URL=http://localhost:5173
