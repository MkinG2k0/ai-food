# Capacitor / native build — скопируй в .env.mobile и заполни.
# Секреты не коммитить (.env.mobile в .gitignore).
# Используется: pnpm cap:build / pnpm build:mobile → vite --mode mobile
# Vite: .env → .env.mobile (mobile перекрывает совпадающие ключи).
# Только VITE_* — серверные секреты в apps/ai-app/.env

# ─── AI Gateway (prod) ────────────────────────────────────
# Deployed gateway origin, без /v1
VITE_AI_GATEWAY_URL=https://your-gateway.example
VITE_AI_GATEWAY_API_KEY=

# Опционально (иначе берутся из .env):
# VITE_APP_URL=https://ai-food-mobile.vercel.app
# VITE_AUTH_MOCK=false
# VITE_TELEGRAM_BOT_USERNAME=
# VITE_LEGAL_SITE_URL=
