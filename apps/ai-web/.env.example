# UI login password (generate: openssl rand -base64 24)
ADMIN_PASSWORD=
# Session cookie signing (openssl rand -base64 32)
ADMIN_SESSION_SECRET=
# Same value as apps/ai-app ADMIN_API_KEY (server-only)
ADMIN_API_KEY=
# Gateway base URL (Dokploy: public HTTPS origin of ai-app, no trailing slash)
AI_GATEWAY_URL=http://127.0.0.1:3000
# Canonical site URL for sitemap / OG / metadataBase
# Dokploy: https://your-landing.example.com (also pass as Docker build-arg SITE_URL)
# Vercel: platform sets VERCEL_URL if SITE_URL unset
SITE_URL=
