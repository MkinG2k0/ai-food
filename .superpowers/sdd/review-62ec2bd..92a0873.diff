ody?.action; +    const requestedDays = req.body?.days; +    const now = new Date(); +    let data: { +      subscriptionStatus: 'none' | 'active'; +      subscriptionExpiresAt: Date | null; +    }; + +    if (action === 'activate') { +      if ( +        requestedDays !== undefined && +        (typeof requestedDays !== 'number' || +          !Number.isFinite(requestedDays) || +          requestedDays <= 0) +      ) { +        throw new ApiError( +          400, +          'VALIDATION_ERROR', +          'days must be a positive number.', +        ); +      } +      const days = +        requestedDays === undefined +          ? await getSubscriptionDurationDays(prisma) +          : Math.floor(requestedDays); +      const expiresAt = new Date(now); +      expiresAt.setUTCDate(expiresAt.getUTCDate() + days); +      data = { +        subscriptionStatus: 'active', +        subscriptionExpiresAt: expiresAt, +      }; +    } else if (action === 'extend') { +      if ( +        typeof requestedDays !== 'number' || +        !Number.isInteger(requestedDays) || +        requestedDays < 1 +      ) { +        throw new ApiError( +          400, +          'VALIDATION_ERROR', +          'days required for extend.', +        ); +      } +      const base = +        user.subscriptionExpiresAt && user.subscriptionExpiresAt > now +          ? user.subscriptionExpiresAt +          : now; +      const expiresAt = new Date(base); +      expiresAt.setUTCDate(expiresAt.getUTCDate() + requestedDays); +      data = { +        subscriptionStatus: 'active', +        subscriptionExpiresAt: expiresAt, +      }; +    } else if (action === 'revoke') { +      data = { +        subscriptionStatus: 'none', +        subscriptionExpiresAt: null, +      }; +    } else { +      throw new ApiError( +        400, +        'VALIDATION_ERROR', +        'action must be activate, extend, or revoke.', +      ); +    } + +    const updated = await prisma.user.update({ +      where: { id: user.id }, +      data,